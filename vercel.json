{
  "version": 2,
  "functions": {
    "api/*.js": {
      "memory": 512,
      "maxDuration": 10
    }
  },
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "src": "/assinar", "dest": "/assinar.html" },
    { "src": "/app", "dest": "/index.html" },
    { "src": "/", "dest": "/landing.html" }
  ]
}
